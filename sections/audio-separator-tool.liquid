{{ 'audio-separator.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  CÔNG CỤ TÁCH ÂM THANH — NĂM CAM
  Chạy ngay trên trình duyệt của khách (không cần máy chủ): tách nhạc nền / bass / phần giọng bằng thuật toán,
  dựng phổ nốt nhạc + xuất file MIDI. Tuỳ chọn: dán địa chỉ máy chủ AI vào ô "Địa chỉ API" để thêm kết quả tách bằng AI.
{%- endcomment -%}

<div class="audio-separator-wrapper" data-audio-separator data-endpoint="{{ section.settings.api_endpoint | escape }}">
  <div class="separator-header">
    <h2 class="separator-title">{{ section.settings.heading | escape }}</h2>
    <p class="separator-subtitle">{{ section.settings.description | escape }}</p>
  </div>

  <div class="separator-error nc-alert err" id="separatorError" role="alert" hidden></div>

  <div class="separator-upload-area" id="dropZone" role="button" tabindex="0" aria-label="Chọn hoặc kéo thả file âm thanh">
    <input type="file" id="audioInput" accept=".mp3,.wav,.m4a,.aac,.ogg,.flac,audio/*" hidden>
    <div class="upload-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    </div>
    <p class="upload-text">Kéo thả file MP3 / WAV vào đây hoặc <span class="upload-link">chọn file</span></p>
    <p class="upload-hint">Tối đa 15 MB. File được xử lý ngay trên máy bạn, không gửi đi đâu (trừ khi bật máy chủ AI).</p>
  </div>

  <div class="separator-loading" id="loadingArea" hidden>
    <div class="loading-spinner"></div>
    <p id="loadingText">Đang đọc file âm thanh…</p>
    <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
  </div>

  <div class="separator-results" id="resultsArea" hidden>
    <div class="results-head">
      <div>
        <h3 class="results-title">Kết quả phân tách</h3>
        <p class="results-file" id="fileInfo"></p>
      </div>
      <button type="button" class="nc-btn nc-btn-ghost nc-btn-small" id="againBtn">Tách file khác</button>
    </div>

    <p class="separator-notice" id="separatorNotice"></p>

    <div class="stems-grid" id="stemsGrid"></div>

    <div class="midi-section">
      <h4>Phổ nốt nhạc (giai điệu chính → MIDI)</h4>
      <p class="midi-stats" id="midiStats"></p>
      <div class="piano-roll-container" id="pianoRoll">
        <canvas id="midiCanvas" aria-label="Phổ nốt nhạc"></canvas>
      </div>
      <a id="downloadMidiBtn" class="nc-btn nc-btn-primary" href="#" download="ban-pho.mid" hidden>Tải xuống file MIDI</a>
    </div>
  </div>
</div>

<script src="{{ 'audio-separator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Công cụ tách âm thanh",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề",
      "default": "Công cụ tách âm thanh & tạo phổ nốt nhạc"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Mô tả",
      "default": "Tải bản nhạc của bạn lên: hệ thống tách nhạc nền, bass, phần giọng và dựng phổ nốt để bạn dễ luyện tập."
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Địa chỉ API máy chủ AI (không bắt buộc)",
      "info": "Để trống = chỉ xử lý trên trình duyệt. Chỉ nhận địa chỉ https://"
    }
  ]
}
{% endschema %}
